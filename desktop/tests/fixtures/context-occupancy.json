    {
      "name": "the newest finished turn with figures",
      "turns": [
        {
          "role": "agent",
          "status": "complete",
          "started_at": "2026-10-13T10:00:00Z",
          "ended_at": "2026-10-13T10:01:00Z",
          "usage": {
            "input_tokens": 0,
            "output_tokens": 0,
            "context_tokens_after_turn": 100,
            "context_window": 200000
          }
        },
        {
          "role": "agent",
          "status": "complete",
          "started_at": "2026-10-13T10:05:00Z",
          "ended_at": "2026-10-13T10:06:00Z",
          "usage": {
            "input_tokens": 0,
            "output_tokens": 0,
            "context_tokens_after_turn": 150,
            "context_window": 200000
          }
        }
      ],
      "compaction": null,
      "expected": {
        "used_tokens": 150,
        "window_tokens": 200000,
        "fraction": 0.00075
      }
    },
