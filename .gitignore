# Rust
target/

# JS / Vite
node_modules/
dist/
build/
out/

# Vitest browser-mode output (failure screenshots / attachments) — incidental
# run artifacts, not asserted baselines (this suite checks measured geometry,
# not visual regression).
.vitest-attachments/
**/__screenshots__/

# Tauri generated
desktop/src-tauri/gen/

# Retired paths: a checkout from before the move to desktop/ and ios/ keeps
# these ignored files after pulling. Ignoring them still keeps them out of
# `git add -A`, Local.xcconfig (a personal team id) above all.
crates/app/gen/
SwitchboardMobile/SwitchboardMobileKit/Generated/
SwitchboardMobile/SwitchboardMobileKit/.swiftpm/
SwitchboardMobile/SwitchboardMobileKit/.build/
SwitchboardMobile/Config/Local.xcconfig

# iOS: `make ios-crypto` output, and Xcode per-user state
ios/SwitchboardMobileKit/Generated/
ios/SwitchboardMobileKit/.swiftpm/
ios/SwitchboardMobileKit/.build/
ios/Config/Local.xcconfig
xcuserdata/
DerivedData/

# Local switchboard state
.switchboard/
/.antigravitycli
# Per-checkout dev runtime cache (maps repo path → id); developer-local, never committed
/cache/

# fake_agy test-fixture control files (written into per-test cwds by
# fixture-backed dispatches)
.fake_agy.*
/.claude
